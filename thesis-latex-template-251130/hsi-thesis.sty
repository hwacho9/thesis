% title %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\jmtitlepage}{
  \thispagestyle{empty}
  \vspace*{10mm}
  \begin{center}
    \huge{理 工 学 研 究 科

      \vspace*{12mm}

      \yearmonthstr

      \vspace*{12mm}
      
      卒 業 論 文}
  \end{center}
  \vspace*{32mm}
  \begin{center}
    \huge\textbf{\titlestr}
  \end{center}
  \vspace*{32mm}
  \begin{center}
    \huge{\studentnumberstr~~\authorstr}
  \end{center}
  \vspace*{3mm}
  \begin{center}
    \huge{(人間システム工学科)}
  \end{center}
  \clearpage
}

\newcommand{\jbtitlepage}{
  \thispagestyle{empty}
  \vspace*{30mm}
  \begin{center}
    \Large{卒業論文}
  \end{center}
  \vspace*{32mm}
  \begin{center}
    \Large\textbf{\titlestr}
  \end{center}
  \vspace*{32mm}
  \begin{center}
    \Large{
      関西学院大学 理工学部 人間システム工学科

      \vspace*{5mm}

      \studentnumberstr~~\authorstr
    }
  \end{center}
  \vspace*{32mm}
  \begin{center}
    \Large{\yearmonthstr}
  \end{center}
  \vspace*{15mm}
  \begin{center}
    \Large{指導教員~~\mentorstr~\mentortitlestr}
  \end{center}
  \clearpage
}

% abstract %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\jabstractpage}{
  \thispagestyle{empty}
  \begin{center}
    \Large\textbf{\titlestr}
  \end{center}
  \vspace*{5mm}
  \begin{center}
    \large{\authorstr}
  \end{center}
  \vspace*{5mm}
  \begin{flushleft}
    \textbf{内容梗概}
  \end{flushleft}
  \vspace*{2mm}
  \par
  \abstracttext
  \vspace*{5mm}
  \begin{flushleft}
    \textbf{キーワード}
  \end{flushleft}
  \par
  \keywordsstr
  \clearpage
}

